# WorkPilot AI - Environment Configuration Example
# Copy to .env or set environment variables in production / Cloud Run

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# Database Connection String
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=WorkPilotDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Gemini AI Credentials
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE
Gemini__Model=gemini-1.5-flash

# Google OAuth & Calendar API
Google__ClientId=YOUR_GOOGLE_CLIENT_ID_HERE
Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET_HERE
Google__RedirectUri=http://localhost:5050/api/calendar/callback

# Email Provider Configuration (HTTPS API over Port 443)
# Supported Providers: "Resend", "SendGrid", "Smtp", "Simulated"
Email__Provider=Resend
Email__ApiKey=YOUR_EMAIL_API_KEY_HERE
Email__SenderEmail=onboarding@resend.dev
Email__SenderName=WorkPilot AI

# Optional SMTP Configuration (If Email__Provider=Smtp)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=465
Email__SenderPassword=YOUR_SMTP_APP_PASSWORD_HERE
